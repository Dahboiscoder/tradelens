# Local dev: `docker compose up -d postgres` starts a matching Postgres instance.
# Production: point this at your hosted Postgres (Neon, Supabase, Vercel Postgres, RDS, ...).
DATABASE_URL="postgresql://tradelens:tradelens@localhost:5435/tradelens"

# Signs auth session JWTs. Generate your own: `openssl rand -hex 32`
JWT_SECRET="replace-with-a-random-64-char-hex-string"

# Encrypts exchange API keys/secrets at rest (AES-256-GCM, 32 bytes hex).
# Generate your own: `openssl rand -hex 32`
ENCRYPTION_KEY="replace-with-a-random-64-char-hex-string"

# Base URL of this app — used to build Stripe checkout success/cancel redirect URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (create these in your own Stripe dashboard — see README "Billing setup").
# Test-mode keys start with sk_test_ / whsec_ / price_ — never commit live keys.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_TEAM=""

NODE_ENV="development"
